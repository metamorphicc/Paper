{
  "name": "papertrade-meme-research",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "description": "Local Papertrade community hub, protocol readers and isolated trading sandbox",
  "engines": {
    "node": ">=24.11.1"
  },
  "scripts": {
    "capture": "tsx scripts/capture-docs.ts",
    "probe": "tsx scripts/probe-chain.ts",
    "simulate": "tsx scripts/simulate.ts",
    "check": "tsc --noEmit",
    "test": "tsx --test packages/**/*.test.ts",
    "dev": "npm run dev --workspace=@paperclub/web",
    "build": "npm run build --workspace=@paperclub/web",
    "check:web": "npm run check --workspace=@paperclub/web",
    "db:migrate": "npm run prepare:runtime --workspace=@paperclub/web",
    "read:protocol": "tsx scripts/read-protocol.ts",
    "read:domains": "tsx scripts/read-signature-domains.ts",
    "probe:integration": "tsx scripts/probe-integration-surface.ts",
    "read:treasury": "tsx scripts/read-treasury.ts",
    "capture:official": "tsx scripts/capture-official.ts",
    "validate:integration": "tsx scripts/validate-integration.ts",
    "index": "tsx scripts/index-chain.ts",
    "smoke:web": "tsx scripts/smoke-web.ts",
    "qa:hosted": "tsx scripts/qa-hosted.ts",
    "format:check": "prettier --check apps/web packages scripts",
    "contracts:compile": "tsx scripts/compile-contracts.ts",
    "release:prepare": "tsx scripts/prepare-deployment.ts",
    "release:package": "tsx scripts/verification-package.ts",
    "release:verify": "tsx scripts/verify-package.ts",
    "release:rehearse": "tsx scripts/rehearse-deployment.ts",
    "rewards:snapshot": "tsx scripts/campaign-snapshot.ts",
    "strategy:replay": "tsx scripts/replay-strategies.ts",
    "monitor:upgrades": "tsx scripts/check-upgrades.ts",
    "monitor:app": "tsx scripts/monitor-application.ts",
    "ops:run": "tsx scripts/run-operations.ts",
    "qa:worker": "tsx scripts/qa-chain-worker.ts",
    "data:backup": "tsx scripts/backup-data.ts",
    "database:backup": "tsx scripts/database-backup.ts",
    "database:restore": "tsx scripts/database-backup.ts --restore",
    "launch:check": "tsx scripts/launch-readiness.ts"
  },
  "dependencies": {
    "pg": "8.23.1",
    "viem": "2.57.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@electric-sql/pglite-socket": "0.2.13",
    "@openzeppelin/contracts": "5.6.1",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "hardhat": "3.19.0",
    "prettier": "3.9.10",
    "solc": "0.8.37",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}

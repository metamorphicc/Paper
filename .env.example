# Public read-only RPC. No wallet or private key is required by this workspace.
HYPEREVM_RPC_URL=https://rpc.hyperliquid.xyz/evm

# Required for Vercel: attach Postgres/Neon and keep its credential server-side.
# Never use a NEXT_PUBLIC_ prefix for a database URL.
DATABASE_URL=
# Exact public HTTPS origin. Vercel-provided deployment origins are also recognized.
PAPERCLUB_APP_ORIGIN=https://paper-sooty.vercel.app

# Historical balances require an archive provider that passes the capability canary.
HYPEREVM_ARCHIVE_RPC_URL=https://hyperliquid.drpc.org?include_hl_native_tx=true
# Public read-only addresses; both remain unselected until reviewed.
TREASURY_ADDRESS=
TREASURY_ASSET_ADDRESS=


